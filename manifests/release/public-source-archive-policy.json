    "configs/busybox/k1om-1.19.4.config",
    "tools/kernel/reproduce-tested-k1om-kernel.sh",
    "tools/kernel/build-candidate-mpss-modules.sh",
    "tools/release/build-rc5-containers.sh",
    "tools/release/build-bootstrap-root.sh",
    "tools/release/build-public-root.sh",
    "tools/release/build-public-clean-root.py",
    "tools/release/validate-public-source-hygiene.py",
    "tools/uos/newc_archive.py",
    "manifests/release/prebuilt-clean-profile.json",
    "manifests/release/public-source-archive-policy.json"
  ]
}
