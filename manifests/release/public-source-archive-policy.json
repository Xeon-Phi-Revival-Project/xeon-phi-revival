{
  "schema": "xpr-public-source-archive-policy-v1",
  "purpose": "Exclude machine-specific historical evidence from public source packages without removing build or corresponding-source material from the repository.",
  "exclude_prefixes": [
    "docs/ubuntu-port/",
    "docs/uos/",
    "manifests/experiments/",
    "tools/ubuntu-port/"
  ],
  "exclude_paths": [
    "docs/kernel/candidate-build-validation.md",
    "docs/kernel/source-search-report.md",
    "docs/development/xpr-init-rsa-validation-2026-08-12.md",
    "docs/research/history/publication-audit-20260727.md",
    "docs/publication-audit-20260727.md",
    "docs/release/xpr-os-0.1.0-rc3-multiagent-audit.md",
    "docs/release/xpr-os-0.1.0-rc6-review-report.md",
    "docs/release/xpr-uos-0.1-license-review.md",
    "manifests/release/xpr-uos-0.1-license-matrix.yml",
    "tools/uos/build-minimal-k1om-initramfs.sh",
    "tools/uos/run-micdir-pid1-handoff-experiment.sh",
    "tools/uos/run-micdir-second-stage-service-experiment.sh"
  ],
  "allow_paths": [
    "tools/kernel/reproduce-tested-k1om-kernel-historical-paths.sh"
  ],
  "required_paths": [
    "LICENSE",
    "NOTICE.md",
    "README.md",
